<!DOCTYPE html>
<html>
<head>
    <title>Manage Streams & Subjects</title>
    <link rel="stylesheet" href="style.css">
    <script src="auth.js"></script>
    <style>
        .filter-container {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
            flex-wrap: wrap;
            align-items: center;
        }
        .filter-container select {
            padding: 10px 20px;
            border-radius: 20px;
            border: none;
            background: rgba(255,255,255,0.1);
            color: white;
            font-size: 14px;
            min-width: 150px;
        }
        .filter-container select option {
            background: #1a1a2e;
            color: white;
        }
        .filter-container input {
            padding: 10px 20px;
            border-radius: 20px;
            border: none;
            background: rgba(255,255,255,0.1);
            color: white;
            font-size: 14px;
            min-width: 200px;
        }
        .filter-container input::placeholder {
            color: #666;
        }

        .subject-item {
            background: rgba(255,255,255,0.05);
            padding: 12px 15px;
            border-radius: 8px;
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }
        .subject-item:hover {
            background: rgba(255,255,255,0.1);
        }
        .subject-item .info {
            color: white;
        }
        .subject-item .info .grade-tag {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 12px;
            background: rgba(6, 211, 247, 0.2);
            color: #06d3f7;
            font-size: 12px;
            margin-left: 8px;
        }
        .subject-item .delete-btn {
            background: #e74c3c;
            padding: 4px 14px;
            border-radius: 15px;
            border: none;
            color: white;
            cursor: pointer;
            font-size: 12px;
        }
        .subject-item .delete-btn:hover {
            background: #c0392b;
        }

        .add-form {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
            margin-top: 20px;
            padding: 15px;
            background: rgba(255,255,255,0.05);
            border-radius: 12px;
        }
        .add-form input, .add-form select {
            padding: 10px 15px;
            border-radius: 20px;
            border: none;
            background: rgba(255,255,255,0.1);
            color: white;
            font-size: 14px;
        }
        .add-form input::placeholder {
            color: #666;
        }
        .add-form select option {
            background: #1a1a2e;
            color: white;
        }
        .add-form .add-btn {
            background: #2ecc71;
            padding: 10px 25px;
            border-radius: 20px;
            border: none;
            color: white;
            cursor: pointer;
            font-weight: bold;
        }
        .add-form .add-btn:hover {
            background: #27ae60;
        }

        .no-subjects {
            text-align: center;
            padding: 30px;
            color: #888;
        }
        .no-subjects .icon {
            font-size: 48px;
            display: block;
            margin-bottom: 15px;
        }

        #subjectList {
            max-height: 400px;
            overflow-y: auto;
            padding-right: 5px;
        }
        #subjectList::-webkit-scrollbar {
            width: 6px;
        }
        #subjectList::-webkit-scrollbar-track {
            background: rgba(255,255,255,0.05);
            border-radius: 10px;
        }
        #subjectList::-webkit-scrollbar-thumb {
            background: #06d3f7;
            border-radius: 10px;
        }
        #subjectList::-webkit-scrollbar-thumb:hover {
            background: #04b5d9;
        }

        .back-btn {
            margin-top: 20px;
            width: 100%;
            padding: 12px;
        }

        .message-box {
            padding: 12px 15px;
            border-radius: 8px;
            margin-bottom: 15px;
            display: none;
        }
        .message-box.success {
            display: block;
            background: rgba(46, 204, 113, 0.2);
            border: 1px solid #2ecc71;
            color: #2ecc71;
        }
        .message-box.error {
            display: block;
            background: rgba(231, 76, 60, 0.2);
            border: 1px solid #e74c3c;
            color: #e74c3c;
        }

        .section-title {
            color: #06d3f7;
            margin-top: 10px;
            margin-bottom: 15px;
        }

        .count-info {
            color: #888;
            font-size: 14px;
            margin-bottom: 10px;
        }
    </style>
</head>

<body class="admin-bg">

<h1 class="main-title">📚 Manage Streams & Subjects</h1>

<div class="card">
    <h2>Manage Subjects</h2>

    <div id="messageBox" class="message-box"></div>

   <div class="filter-container">
    <input type="text" id="searchInput" placeholder="🔍 Search subjects..." onkeyup="loadSubjects()">
</div>

    <!-- Subject List -->
    <div class="section-title" id="sectionTitle">Subjects for: Science - All Grades</div>
    <div class="count-info" id="countInfo"></div>
    <div id="subjectList"></div>

    <!-- Add Subject Form -->
    <div class="add-form">
        <input type="text" id="newSubjectName" placeholder="Subject name...">
        
        <select id="newSubjectStream">
            <option value="Science">🔬 Science</option>
            <option value="Commerce">📊 Commerce</option>
            <option value="Humanities">📜 Humanities</option>
            <option value="General">📋 General (Grade 8-9)</option>
        </select>
        
        <select id="newSubjectGrade">
            <option value="">Select Grade</option>
            <option value="Grade 8">Grade 8</option>
            <option value="Grade 9">Grade 9</option>
            <option value="Grade 10">Grade 10</option>
            <option value="Grade 11">Grade 11</option>
            <option value="Grade 12">Grade 12</option>
        </select>
        
        <button class="add-btn" onclick="addSubject()">➕ Add Subject</button>
    </div>

    <button onclick="window.location.href='admin.html'" class="back-btn">← Back to Dashboard</button>
</div>

<script>
const admin = JSON.parse(localStorage.getItem("loggedInUser"));

if (!admin || admin.role !== "admin") {
    window.location.href = "Login.html";
}

// ============================================
// ===== SHOW MESSAGE =====
// ============================================
function showMessage(message, type) {
    const box = document.getElementById('messageBox');
    box.textContent = message;
    box.className = 'message-box ' + type;
    box.style.display = 'block';
    setTimeout(() => {
        box.style.display = 'none';
    }, 4000);
}

// ============================================
// ===== LOAD SUBJECTS =====
// ============================================
async function loadSubjects() {
    const container = document.getElementById('subjectList');
    const search = document.getElementById('searchInput').value.trim().toLowerCase();

    document.getElementById('sectionTitle').textContent = '📖 All Subjects';
    container.innerHTML = '<p style="color: #aaa; text-align: center;">📊 Loading subjects...</p>';

    try {
        // Fetch ALL subjects (no stream or grade filter)
        const response = await fetch(`/all-subjects`);
        const data = await response.json();

        if (!data.success || data.subjects.length === 0) {
            container.innerHTML = `
                <div class="no-subjects">
                    <span class="icon">📭</span>
                    <p>No subjects found</p>
                </div>
            `;
            document.getElementById('countInfo').textContent = '';
            return;
        }

        let filteredSubjects = data.subjects;
        if (search) {
            filteredSubjects = filteredSubjects.filter(s => 
                s.subject_name.toLowerCase().includes(search)
            );
        }

        if (search && filteredSubjects.length > 0) {
            document.getElementById('countInfo').textContent = `Showing ${filteredSubjects.length} subjects`;
        } else {
            document.getElementById('countInfo').textContent = '';
        }

        if (filteredSubjects.length === 0) {
            container.innerHTML = `
                <div class="no-subjects">
                    <span class="icon">🔍</span>
                    <p>No subjects match your search</p>
                </div>
            `;
            return;
        }

        let html = '';
        filteredSubjects.forEach(subject => {
            const streamDisplay = subject.stream || 'General';
            html += `
                <div class="subject-item">
                    <div class="info">
                        ${subject.subject_name}
                        <span class="grade-tag">📚 ${subject.grade_level}</span>
                        <span class="grade-tag" style="background: rgba(243,156,18,0.2); color: #f39c12;">${streamDisplay}</span>
                    </div>
                    <button class="delete-btn" onclick="deleteSubject(${subject.subject_id})">🗑️ Delete</button>
                </div>
            `;
        });

        container.innerHTML = html;

    } catch (error) {
        console.error("Error loading subjects:", error);
        container.innerHTML = '<p style="color: #e74c3c; text-align: center;">❌ Error loading subjects</p>';
        document.getElementById('countInfo').textContent = '';
    }
}

// ============================================
// ===== ADD SUBJECT =====
// ============================================
async function addSubject() {
    const subjectName = document.getElementById('newSubjectName').value.trim();
    const stream = document.getElementById('newSubjectStream').value;
    const gradeLevel = document.getElementById('newSubjectGrade').value;

    if (!subjectName || !gradeLevel) {
        showMessage('Please fill all fields', 'error');
        return;
    }

    try {
        const response = await fetch('/add-subject', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                subject_name: subjectName,
                stream: stream,
                grade_level: gradeLevel
            })
        });

        const data = await response.json();

        if (data.success) {
            showMessage(data.message, 'success');
            document.getElementById('newSubjectName').value = '';
            document.getElementById('newSubjectGrade').value = '';
            loadSubjects();
        } else {
            showMessage(data.message, 'error');
        }
    } catch (error) {
        showMessage('Error adding subject', 'error');
    }
}

// ============================================
// ===== DELETE SUBJECT =====
// ============================================
async function deleteSubject(id) {
    if (!confirm('Are you sure you want to delete this subject?')) return;

    try {
        const response = await fetch('/delete-subject/' + id, {
            method: 'DELETE'
        });

        const data = await response.json();

        if (data.success) {
            showMessage(data.message, 'success');
            loadSubjects();
        } else {
            showMessage(data.message, 'error');
        }
    } catch (error) {
        showMessage('Error deleting subject', 'error');
    }
}

// ============================================
// ===== PAGE LOAD =====
// ============================================
document.addEventListener('DOMContentLoaded', function() {
    loadSubjects();
});
</script>

</body>
</html>
